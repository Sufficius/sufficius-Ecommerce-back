generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabelas principais simplificadas
model Usuario {
  id              String        @id @default(uuid())
  nome            String
  email           String        @unique
  telefone        String?        @unique
  senhaHash       String
  fotoUrl         String?
  dataNascimento  DateTime?
  criadoEm        DateTime      @default(now())
  tipo            TipoUsuario   @default(CLIENTE)
  atualizadoEm    DateTime      @updatedAt
  status          StatusUsuario @default(ATIVO)
  emailVerificado Boolean       @default(false)
  googleId        String?
  ultimoLogin     DateTime?

  // Relações
  Endereco  Endereco[]
  Carrinho  Carrinho?
  Pedido    Pedido[]
  Pagamento Pagamento[]
  Reembolso Reembolso[]
}

model Endereco {
  id        String   @id @default(uuid())
  usuarioId String
  rua       String
  numero    String
  bairro    String
  cidade    String
  provincia String   @default("Luanda")
  padrao    Boolean  @default(false)
  telefone  String?
  criadoEm  DateTime @default(now())

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  Pedido  Pedido[]
}

model Estoque {
  id        String      @id @default(uuid())
  nome      String
  descricao String?
  foto      String?
  preco     Float
  quantidade  Int
  id_categoria    String    @map("id_categoria")
  status        StatusProduto     @default(ATIVO)
  criadoEm    DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  Categoria       Categoria?      @relation(fields: [id_categoria], references: [id])
  ImagemProduto   ImagemProduto[]
}
model Produto {
  id               String        @id @default(uuid())
  nome             String
  descricao        String?
  foto              String?      
  preco            Float
  quantidade       Int
  id_categoria     String        @map("id_categoria")
  status           StatusProduto @default(ATIVO)
  criadoEm         DateTime      @default(now())
  atualizadoEm     DateTime      @updatedAt

  // Relações
  Categoria     Categoria?      @relation(fields: [id_categoria], references: [id])
  ImagemProduto ImagemProduto[]
  ItemCarrinho  ItemCarrinho[]
  ItemPedido    ItemPedido[]
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  criadoEm  DateTime @default(now())
  foto      String?  // URL da foto da categoria

  Produto Produto[]
  Estoque Estoque[]
}

model ImagemProduto {
  id        String  @id @default(uuid())
  produtoId String
  estoqueId String
  url       String
  ordem     Int     @default(0)
  principal Boolean @default(false)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  estoque Estoque @relation(fields: [estoqueId],references: [id], onDelete: Cascade)

  @@index([produtoId, estoqueId])
}

model Carrinho {
  id           String   @id @default(uuid())
  usuarioId    String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ItemCarrinho ItemCarrinho[]
}

model ItemCarrinho {
  id         String   @id @default(uuid())
  carrinhoId String
  produtoId  String
  quantidade Int      @default(1)
  criadoEm   DateTime @default(now())

  carrinho Carrinho @relation(fields: [carrinhoId], references: [id], onDelete: Cascade)
  produto  Produto  @relation(fields: [produtoId], references: [id])

  @@unique([carrinhoId, produtoId])
  @@index([carrinhoId])
}

model Pedido {
  id           String       @id @default(uuid())
  numeroPedido String       @unique
  usuarioId    String
  enderecoId   String
  status       StatusPedido @default(PAGAMENTO_PENDENTE)

  frete    Float
  desconto Float @default(0)
  total    Float

  // Informações de entrega
  metodoEnvio    String
  codigoRastreio String?
  dataEntrega    DateTime?
  entregueEm     DateTime?

  // Informações de pagamento
  metodoPagamento     MetodoPagamento
  statusPagamento     StatusPagamento @default(PENDENTE)
  referenciaPagamento String? // ID da transação do gateway
  dataPagamento       DateTime? // Quando o pagamento foi realizado

  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Relações
  usuario         Usuario           @relation(fields: [usuarioId], references: [id])
  endereco        Endereco          @relation(fields: [enderecoId], references: [id])
  ItemPedido      ItemPedido[]
  HistoricoPedido HistoricoPedido[]
  Pagamento       Pagamento[]
  Reembolso       Reembolso[]

  @@index([usuarioId])
  @@index([status])
  @@index([criadoEm])
  @@index([statusPagamento])
}

model ItemPedido {
  id            String   @id @default(uuid())
  pedidoId      String
  produtoId     String
  quantidade    Int
  precoUnitario Float
  precoTotal    Float
  criadoEm      DateTime @default(now())

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([pedidoId])
}

model HistoricoPedido {
  id         String       @id @default(uuid())
  pedidoId   String
  status     StatusPedido
  observacao String?
  criadoEm   DateTime     @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}



// TABELA: Pagamento
model Pagamento {
  id        String          @id @default(uuid())
  pedidoId  String
  usuarioId String
  metodo    MetodoPagamento
  status    StatusPagamento @default(PENDENTE)
  tipo      TipoPagamento   @default(PAGAMENTO_PEDIDO)
  valor     Float
  comprovativoUrl String? // URL do comprovante de pagamento (para métodos manuais)

  // Dados específicos por método de pagamento
  mpesaPhoneNumber   String? // Para M-Pesa
  mpesaTransactionId String? // Para M-Pesa
  unitelMoneyPhone   String? // Para Unitel Money
  contaBancaria      String? // Para transferência bancária
  referenciaBancaria String? // Referência de pagamento bancário
  cartaoLast4        String? // Últimos 4 dígitos do cartão
  cartaoBandeira     String? // Bandeira do cartão

  // Informações do gateway/processadora
  gatewayId       String? // ID da transação no gateway
  gatewayResponse String? // Resposta completa do gateway (JSON)
  gatewayCode     String? // Código de resposta do gateway

  // Validações e confirmações
  confirmadoPor      String? // Admin que confirmou o pagamento manual
  confirmadoEm       DateTime?
  canceladoPor       String? // Admin que cancelou o pagamento
  canceladoEm        DateTime?
  motivoCancelamento String?

  // Auditoria
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt
  dataExpiracao DateTime? // Data de expiração do pagamento
  tentativas    Int       @default(0) // Tentativas de pagamento

  // Relações
  pedido     Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario    Usuario              @relation(fields: [usuarioId], references: [id])
  Reembolso  Reembolso[] // UM-para-MUITOS (permite múltiplos reembolsos)
  historicos HistoricoPagamento[]

  @@unique([gatewayId], name: "pagamento_gateway_unique")
  @@index([pedidoId])
  @@index([usuarioId])
  @@index([status])
  @@index([criadoEm])
  @@index([gatewayId])
}

// TABELA: Histórico de Pagamento
model HistoricoPagamento {
  id          String          @id @default(uuid())
  pagamentoId String
  status      StatusPagamento
  observacao  String?
  gatewayData String? // Dados adicionais do gateway
  criadoEm    DateTime        @default(now())

  pagamento Pagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@index([pagamentoId])
}

// TABELA: Configurações de Pagamento
model ConfiguracaoPagamento {
  id                  String          @id @default(uuid())
  metodo              MetodoPagamento @unique
  ativo               Boolean         @default(true)
  nomeExibicao        String
  descricao           String?
  taxaPercentual      Float           @default(0)
  taxaFixa            Float           @default(0)
  instrucoes          String? // Instruções para pagamento manual
  limiteMinimo        Float?
  limiteMaximo        Float?
  // Configurações específicas por método
  chavePublicaGateway String? // Para gateways que exigem chave pública
  modoTeste           Boolean         @default(true)
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt

  @@index([metodo])
  @@index([ativo])
}

// TABELA: Reembolso
model Reembolso {
  id              String          @id @default(uuid())
  pagamentoId     String
  pedidoId        String
  usuarioId       String
  valor           Float
  motivo          String
  status          StatusReembolso @default(PENDENTE)
  metodoReembolso MetodoReembolso
  transacaoId     String? // ID da transação de reembolso
  solicitadoPor   String // "USUARIO" ou "ADMIN"
  aprovadoPor     String? // Admin que aprovou
  aprovadoEm      DateTime?
  processadoEm    DateTime?
  observacoes     String?
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  pagamento Pagamento @relation(fields: [pagamentoId], references: [id])
  pedido    Pedido    @relation(fields: [pedidoId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([pagamentoId])
  @@index([pedidoId])
  @@index([usuarioId])
  @@index([status])
}

// Enums otimizados
enum TipoUsuario {
  CLIENTE
  ADMIN
}

enum StatusUsuario {
  ATIVO
  INATIVO
  SUSPENSO
}

enum StatusProduto {
  ATIVO
  INATIVO
  ESGOTADO
}

enum StatusPedido {
  PAGAMENTO_PENDENTE
  PROCESSANDO
  CONFIRMADO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  PROCESSANDO
  APROVADO
  FALHOU
  REEMBOLSADO
  EXPIRADO
  CANCELADO
}

enum MetodoPagamento {
  MPESA
  UNITEL_MONEY
  TRANSFERENCIA_BANCARIA
  CARTAO_CREDITO
  DINHEIRO_ENTREGA
}

// ENUM: Tipo de Pagamento
enum TipoPagamento {
  PAGAMENTO_PEDIDO
  RECARGA_SALDO
  DEPOSITO
}

// ENUM: Status de Reembolso
enum StatusReembolso {
  PENDENTE
  APROVADO
  PROCESSANDO
  CONCLUIDO
  RECUSADO
  CANCELADO
}

// ENUM: Método de Reembolso
enum MetodoReembolso {
  MESMA_VIA // Devolução pelo mesmo método de pagamento
  TRANSFERENCIA // Transferência bancária
  CREDITO_LOJA // Crédito na loja para futuras compras
  OUTRO
}
