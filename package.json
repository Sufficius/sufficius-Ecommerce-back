{
  "name": "sufficius-ecommerce-back",
  "version": "1.0.0",
  "description": "- Para se tornar um comprador, o usuário deve estar cadastrado.\r - Para estar cadastrado deve informar: nome, senha, número de telefone, email.\r - O cadastro é finalizado quando o email e o número de telefone forem verificados.\r - Dados sensíveis do usuário devem ser armazenados de forma segura.",
  "main": "index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "clean": "rm -rf dist node_modules/.prisma node_modules/.cache",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "render-build": "npm ci --omit=dev && npm run build",
    "render-start": "node dist/server.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
